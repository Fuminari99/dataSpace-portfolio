---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { hero } from '../data/home';

interface Props {
  title: string;
  description?: string;
  /** Floats the header over the page instead of stacking it above. See SiteHeader. */
  overlayHeader?: boolean;
}

const { title, description = '', overlayHeader = false } = Astro.props;

/** The clip the hero opens on, and with it the home page's LCP. */
const heroPoster = hero.clips[0].poster;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* The two faces are served from here rather than from Google: a stylesheet
        on another origin blocks the first paint on a second connection, and the
        two files arriving late reflowed every line that had been set in the
        fallback. Both are preloaded so they are in hand before the first
        paint. */}
    <link
      rel="preload"
      href="/fonts/orbit-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/noto-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* The still the hero opens on is the largest thing painted on the home
        page; asking for it early is what takes it off the critical path. */}
    {
      overlayHeader && (
        <link rel="preload" href={heroPoster} as="image" fetchpriority="high" />
      )
    }
  </head>

  <body data-barba="wrapper" class="flex min-h-screen flex-col" data-module="cursor">
    {/*
      Header and footer live inside the Barba container, not outside it. Kept
      outside they persist across a swap, which sounds tidy but breaks the
      transition: the chrome stays nailed in place while the page slides up
      underneath it, and the old page's header sits on top of the new one.
      Inside the container each page carries its own, so the whole thing moves
      as one piece. They are still defined once, here — this is a layout in
      every sense except where the markup ends up in the DOM.
    */}
    <div data-barba="container" data-barba-namespace="default" class="flex flex-1 flex-col">
      <SiteHeader overlay={overlayHeader} />

      {/* `reveal` sits here rather than on one page so every page settles the
          same way; anything not marked `[data-reveal]` is untouched by it. */}
      <main class="flex flex-1 flex-col items-center" data-module="heading-scramble lightbox reveal">
        <slot />
      </main>

      <SiteFooter />
    </div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
