---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { hero } from '../data/home';

interface Props {
  title: string;
  description?: string;
  /** Floats the header over the page instead of stacking it above. See SiteHeader. */
  overlayHeader?: boolean;
  /**
   * Share card for this page, as a site-root path. Defaults to the site-wide
   * card; give a page its own only when the default misrepresents it.
   */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = '',
  overlayHeader = false,
  ogImage = '/og/og-default.jpg',
  ogImageAlt = 'Fractal Variant — the site title over the home page background',
} = Astro.props;

/**
 * Share cards and canonical links have to be absolute — a crawler reads them
 * off the markup with no page to resolve against. `site` in astro.config.mjs
 * is the one place that address is set.
 */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(ogImage, Astro.site).href;
const SITE_NAME = 'Fractal Variant';

/** The clip the hero opens on, and with it the home page's LCP. */
const heroPoster = hero.clips[0].poster;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Open Graph is what Slack, Discord, iMessage, Facebook and LinkedIn read.
        X reads its own twitter:* tags and falls back to these, but naming the
        card type is what gets the wide image rather than a thumbnail. Both
        want the same 1200x630, so one file serves both. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* The two faces are served from here rather than from Google: a stylesheet
        on another origin blocks the first paint on a second connection, and the
        two files arriving late reflowed every line that had been set in the
        fallback. Both are preloaded so they are in hand before the first
        paint. */}
    <link
      rel="preload"
      href="/fonts/orbit-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/noto-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* The still the hero opens on is the largest thing painted on the home
        page; asking for it early is what takes it off the critical path. */}
    {
      overlayHeader && (
        <link rel="preload" href={heroPoster} as="image" fetchpriority="high" />
      )
    }
  </head>

  <body data-barba="wrapper" class="flex min-h-screen flex-col" data-module="cursor">
    {/*
      Header and footer live inside the Barba container, not outside it. Kept
      outside they persist across a swap, which sounds tidy but breaks the
      transition: the chrome stays nailed in place while the page slides up
      underneath it, and the old page's header sits on top of the new one.
      Inside the container each page carries its own, so the whole thing moves
      as one piece. They are still defined once, here — this is a layout in
      every sense except where the markup ends up in the DOM.
    */}
    <div data-barba="container" data-barba-namespace="default" class="flex flex-1 flex-col">
      <SiteHeader overlay={overlayHeader} />

      {/* `reveal` sits here rather than on one page so every page settles the
          same way; anything not marked `[data-reveal]` is untouched by it. */}
      <main class="flex flex-1 flex-col items-center" data-module="heading-scramble lightbox reveal">
        <slot />
      </main>

      <SiteFooter />
    </div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
