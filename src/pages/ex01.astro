---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/sections/PageHeading.astro';
import VisualTriptych from '../components/sections/VisualTriptych.astro';
import ConceptCollage from '../components/sections/ConceptCollage.astro';
import NextExperiment from '../components/sections/NextExperiment.astro';
import { experiments } from '../data/experiments';

const experiment = experiments[0];

// Counts the three of us recorded on the paper worksheet, over three minutes.
// Values and visuals are in `members` order: Fumi, Keagan, Maiya.
const tabs = [
  {
    id: 'breath',
    label: 'BREATH',
    description:
      'Each full inhale and exhale was recorded as a hand-drawn circle, ○, over the course of three minutes, Fumi recorded 56 breaths, Keagan 35, and Maiya 64, showing three different breathing rates within the same fixed duration.',
    values: ['56/3min', '35/3min', '64/3min'],
    visuals: [
      '/assets/video/ex01-breath-fumi-v2.mp4',
      '/assets/video/ex01-breath-keagan-v2.mp4',
      '/assets/video/ex01-breath-maiya.mp4',
    ],
  },
  {
    id: 'pulse',
    label: 'PULSE',
    description:
      'Each heartbeat was then recorded as a single stroke, /, while holding a hand to the neck to feel the pulse. Fumi recorded 111 beats, Keagan 154, and Maiya 101, producing the fastest and most densely marked dataset of the three.',
    values: ['111/3min', '154/3min', '101/3min'],
    visuals: [
      '/assets/video/ex01-pulse-fumi-v2.mp4',
      '/assets/video/ex01-pulse-keagan-v2.mp4',
      '/assets/video/ex01-pulse-maiya.mp4',
    ],
  },
  {
    id: 'blink',
    label: 'BLINK',
    description:
      'Each blink was recorded with a small arc, ∪, everytime it occurred. Fumi recorded 118 blinks, Keagan 114, and Maiya 52, with the marks appearing less evenly spaced as blinking tended to occur in clusters rather than at a consistent rhythm.',
    values: ['118/3min', '114/3min', '52/3min'],
    visuals: [
      '/assets/video/ex01-blink-fumi-v2.mp4',
      '/assets/video/ex01-blink-keagan-v2.mp4',
      '/assets/video/ex01-blink-maiya.mp4',
    ],
  },
];
---

<BaseLayout title={`${experiment.title} — Data Spaces`} description={experiment.summary}>
  <PageHeading eyebrow={experiment.eyebrow} title={experiment.title} intro={experiment.intro} />

  <VisualTriptych label="Body rhythms" tabs={tabs} />

  <ConceptCollage />

  <NextExperiment />
</BaseLayout>
