---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/sections/PageHeading.astro';
import FeatureStill from '../components/sections/FeatureStill.astro';
import WideVisualRows from '../components/sections/WideVisualRows.astro';
import NextExperiment from '../components/sections/NextExperiment.astro';
import { experiments } from '../data/experiments';

const experiment = experiments[3];

// Drawn from the mix notes in the project's audio folder.
const lead =
  'Three layers, each locked to a rate we actually recorded. Ocean is the ground the other two are built on: 4.5 second waves under a 17 second swell, standing in for a resting 13.3 breaths a minute.';

const rows = [
  {
    text: 'The train carries the pulse at 0.84 seconds a beat — 71.4 to the minute. Its two-part figure does the work of a heartbeat’s lub-dub, and the sub-bass sits in the 20 to 120Hz band where the ocean is weakest, so the beat is felt rather than heard.',
    align: 'right' as const,
  },
  {
    text: 'Footsteps in sand mark the blink at an average of 3.2 seconds. They are placed on a log-normal distribution rather than a grid, sometimes doubling up, because blinking arrives in clusters. Each one ducks the other layers by 3.2dB — the sonic equivalent of vision briefly pulling back.',
    align: 'left' as const,
  },
];
---

<BaseLayout title={`${experiment.title} — Data Spaces`} description={experiment.summary}>
  <PageHeading eyebrow={experiment.eyebrow} title={experiment.title} intro={experiment.intro} />

  <FeatureStill
    label="TITLE OF VISUALS"
    id="title-of-visuals"
    video="/assets/video/ex04-sensory.mp4"
    poster="/assets/video/ex04-sensory.jpg"
    alt="Sensory Data — the three recorded rhythms rendered as moving line fields"
  />

  <WideVisualRows
    label="Conceptualisation"
    id="conceptualisation"
    lead={lead}
    gap="wide"
    rows={[{ align: 'left' }, rows[0], rows[1]]}
  />

  <NextExperiment />
</BaseLayout>
