---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/sections/PageHeading.astro';
import FeatureStill from '../components/sections/FeatureStill.astro';
import WideVisualRows from '../components/sections/WideVisualRows.astro';
import NextExperiment from '../components/sections/NextExperiment.astro';
import { experiments } from '../data/experiments';

const experiment = experiments[3];

// Drawn from the workshop sketch: a touch sensor on an Arduino, read into p5
// over a serial bridge, with the reading eased rather than used raw.
const lead =
  'The sensor is the whole input. It reports one number many times a second, and it only speaks up once a reading crosses the threshold set on the board, so what arrives in the browser is a sparse and jumpy stream rather than a smooth signal.';

const rows = [
  {
    text: 'Nothing is drawn from the raw reading. Each frame moves five per cent of the way towards the latest value instead of jumping to it — a low-pass filter, in effect — so a hand landing on the object reads as something swelling and settling rather than as a switch being flipped.',
    align: 'right' as const,
  },
  {
    text: 'That easing is the argument of the experiment. A sensor knows only touched or not touched, and the response is what supplies everything else: how firm the contact was, how long it lasted, whether it is still there. An ordinary object becomes sensable in the reading, not in the wiring.',
    align: 'left' as const,
  },
];
---

<BaseLayout title={`${experiment.title} — Data Spaces`} description={experiment.summary}>
  <PageHeading eyebrow={experiment.eyebrow} title={experiment.title} intro={experiment.intro} />

  <FeatureStill
    label="TOUCH RESPONSE"
    id="touch-response"
    video="/assets/video/ex04-sensory.mp4"
    poster="/assets/video/ex04-sensory.webp"
    alt="Sensory Data — a field of lines swelling and settling under contact"
  />

  <WideVisualRows
    label="Conceptualisation"
    id="conceptualisation"
    lead={lead}
    gap="wide"
    rows={[{ align: 'left' }, rows[0], rows[1]]}
  />

  <NextExperiment />
</BaseLayout>
