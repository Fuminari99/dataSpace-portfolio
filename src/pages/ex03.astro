---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/sections/PageHeading.astro';
import FeatureStill from '../components/sections/FeatureStill.astro';
import SoundLayers from '../components/sections/SoundMixer.astro';
import NextExperiment from '../components/sections/NextExperiment.astro';
import { experiments } from '../data/experiments';

const experiment = experiments[2];

// Rates are the rhythms the three of us counted by hand in Ex01; which sound
// carries which comes from the patch itself — `math_mix` in particles6.toe
// sums ocean, footsteps and gulls, at the volumes named on each stem.
const tracks = [
  { src: '/assets/audio/ex03-breath-v2.mp3', label: 'BREATH', source: 'Ocean' },
  { src: '/assets/audio/ex03-pulse-v2.mp3', label: 'PULSE', source: 'Footsteps' },
  { src: '/assets/audio/ex03-blink-v2.mp3', label: 'BLINK', source: 'Seagulls' },
];

const more = [
  'Breath is continuous, like a sine wave. Pulse and blink are discontinuous. They are broken up, fragmented. Between those two, blink is the more fragmented and the more abrupt.',
  'We picked the ocean for breath first, because it is continuous and sine-like. From there we stayed with what the ocean brings to mind, and took footsteps for pulse and seagulls for blink.',
];

const patch = [
  {
    src: '/assets/td/td-particles.webp',
    alt: 'The particlesGpu node in TouchDesigner, its preview showing a white particle burst',
    name: 'particlesGpu',
    stage: 'GENERATE',
    description: '3,000 points, emitted along a line and driven by the analysed sound.',
  },
  {
    src: '/assets/td/td-render.webp',
    alt: 'The render chain — level_scale, cam2 and render1 — wired together in TouchDesigner',
    name: 'level_scale / cam2 / render1',
    stage: 'RENDER',
    description: 'The particle system is scaled and rendered through the camera.',
  },
  {
    src: '/assets/td/td-output.webp',
    alt: 'The level5 node, showing the graded output in pink, cyan and yellow',
    name: 'level5',
    stage: 'OUTPUT',
    description: 'Colour grading and frame feedback turn movement into trails.',
  },
];


---

<BaseLayout title={`${experiment.title} — Data Spaces`} description={experiment.summary}>
  <PageHeading eyebrow={experiment.eyebrow} title={experiment.title} intro={experiment.intro} />

  <FeatureStill
    label="SOUND INTO VISUALS"
    id="sound-into-visuals"
    video="/assets/video/ex03-expression-v5.mp4"
    poster="/assets/video/ex03-expression-v5.webp"
    alt="Data Expression — line drawings surfacing out of a pale shore, driven by the mix"
  />

  <SoundLayers
    label="SOUND"
    id="sound"
    lead="To find sounds with rhythms close to breath, pulse and blink, we started off with analysing what each one sounds like."
    more={more}
    tracks={tracks}
    figures={patch}
  />

  <FeatureStill
    label="FINAL OUTPUT"
    id="final-output"
    video="/assets/video/ex03-expression-final.mp4"
    poster="/assets/video/ex03-expression-v5.webp"
    alt="Final Data Expression video with its composed ocean, footsteps and seagull soundtrack"
    audible
  />

  <NextExperiment />
</BaseLayout>
