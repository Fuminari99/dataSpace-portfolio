---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import HomeBackground from '../components/sections/HomeBackground.astro';
import HomeConcept from '../components/sections/HomeConcept.astro';
import ExperimentList from '../components/sections/ExperimentList.astro';
import HomeAbout from '../components/sections/HomeAbout.astro';
import { experiments } from '../data/experiments';
import { home } from '../data/site';

// The home page is the whole project in one read: the hero, what the brief was,
// the concept the four experiments share, the experiments themselves, then who
// made it. The anchors come from the Home entry in site.ts so the header panel
// and these sections cannot drift apart.
const anchors = home.sections.map((section) => section.hash);
const [background, ...rest] = anchors;
const experimentAnchors = rest.slice(0, experiments.length);
const team = rest[experiments.length];
---

<BaseLayout
  title="Data Spaces"
  description="A web archive of experiments in collecting, quantifying and giving form to data, by Keagan, Fumi and Maiya."
  overlayHeader
>
  <div class="flex w-full flex-col items-center">
    <HomeHero />

    <HomeBackground id={background} />

    {/* Concept and the experiment list read as one section — the shared
        project direction, then the four experiments it produced. */}
    <section class="flex w-full flex-col gap-16 py-28">
      <HomeConcept />

      <ExperimentList ids={experimentAnchors} />
    </section>

    <HomeAbout id={team} />
  </div>
</BaseLayout>
