---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/sections/PageHeading.astro';
import VisualTriptych from '../components/sections/VisualTriptych.astro';
import StickyVisualRows from '../components/sections/StickyVisualRows.astro';
import NextExperiment from '../components/sections/NextExperiment.astro';
import { experiments } from '../data/experiments';

const experiment = experiments[1];

const noiseTabs = [
  {
    id: 'noise-grid',
    label: 'NOISE GRID',
    description:
      'Our noise grid iterations, explore shifts in movement, texture, and colour to create a animated composition. Viewed together, our grids acts as visual case studies of our own interpretation of Fractal glass — all made using the same source that has been made different through a series of adjustments.',
    visuals: [
      '/assets/video/ex02-noise-keagan-v4.mp4',
      '/assets/video/ex02-noise-fumi.mp4',
      '/assets/video/ex02-noise-maiya-v2.mp4',
    ],
  },
];

const fuzzyLead =
  'The fuzzy grid decidedly moves away from a clean collage that the noise grid offers, into the concise use of nodes and particle dispersion, working to overlap and gathering across the frame. The areas are much more unstable and less defined. The Fuzzy Grids form eventually takes shape as the image becomes much more fragmented — allowing irregularity to be the final composition.';
---

<BaseLayout title={`${experiment.title} — Data Spaces`} description={experiment.summary}>
  <PageHeading eyebrow={experiment.eyebrow} title={experiment.title} intro={experiment.intro} />

  <VisualTriptych tabs={noiseTabs} />

  <StickyVisualRows
    label="FUZZY GRID"
    id="fuzzy-grid"
    lead={fuzzyLead}
    visuals={[
      '/assets/video/ex02-fuzzy-keagan-v3.mp4',
      '/assets/video/ex02-fuzzy-fumi.mp4',
      '/assets/video/ex02-fuzzy-maiya-v2.mp4',
    ]}
  />

  <NextExperiment />
</BaseLayout>
