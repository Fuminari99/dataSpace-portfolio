---
import { hero } from '../../data/home';

/**
 * The home hero: footage under a flat black lift, ruled into uneven vertical
 * columns, with loose square outlines scattered over it and the wordmark in the
 * middle. Everything sits in a 1280 x 667 frame in Figma; the rules and squares
 * are stored as percentages of that frame so the arrangement survives a
 * viewport of any proportion instead of being pinned to pixels.
 */
const FRAME = { width: 1280, height: 667 };

const pctX = (px: number) => `${((px / FRAME.width) * 100).toFixed(3)}%`;
const pctY = (px: number) => `${((px / FRAME.height) * 100).toFixed(3)}%`;

/** Left edge of each column in the design, plus the closing edge. */
const RULES = [0, 196, 505, 908, 1092, 1211, 1280];

/**
 * The squares, as x / y / side in frame pixels. They are grouped rather than
 * scattered — two or three to a cluster, close enough to overlap each other and
 * to keep overlapping as they drift — and the clusters are kept out to the
 * sides so the middle of the frame stays clear for the wordmark.
 *
 * One square in each cluster reports its reading: the average colour of the
 * footage inside it. Giving all ten a readout would stack the figures on top of
 * one another wherever the squares overlap.
 */
const SQUARES = [
  // Left, above the middle.
  { x: 96, y: 250, side: 64, reads: true },
  { x: 140, y: 292, side: 56, reads: false },
  { x: 168, y: 246, side: 48, reads: false },

  // Lower left.
  { x: 280, y: 520, side: 56, reads: true },
  { x: 318, y: 486, side: 48, reads: false },

  // Upper right.
  { x: 900, y: 120, side: 56, reads: true },
  { x: 936, y: 152, side: 48, reads: false },

  // Right, below the middle.
  { x: 1000, y: 380, side: 64, reads: true },
  { x: 1044, y: 424, side: 56, reads: false },
  { x: 1056, y: 356, side: 48, reads: false },
] as const;
---

<section
  class="hero relative flex min-h-[95svh] w-full items-center justify-center overflow-hidden bg-ink"
  data-module="hero-cycle hero-cells"
  style={`--hero-interval:${hero.interval}`}
>
  {
    hero.clips.map((clip, index) => (
      <video
        class="hero__clip"
        data-hero-clip
        data-index={index}
        data-href={clip.href}
        data-label={clip.label}
        aria-hidden={index === 0 ? undefined : 'true'}
        {...(index === 0 ? { poster: clip.poster } : { 'data-poster': clip.poster })}
        role="img"
        aria-label={clip.alt}
        muted
        loop
        playsinline
        preload="none"
      >
        <source data-src={clip.video} type="video/mp4" />
      </video>
    ))
  }

  <div class="absolute inset-0 bg-ink/30" aria-hidden="true"></div>

  {/* The column rules, the squares and their readouts are the hero's own
      decoration: the counts they carry are set out properly on the About page,
      so a screen reader is not made to walk a scattered instrument panel. */}
  <div class="absolute inset-0" aria-hidden="true">
    {
      RULES.map((x) => (
        <span
          class="absolute inset-y-0 w-px bg-hero-rule"
          style={`left:${pctX(x)};${x === FRAME.width ? 'translate:-100% 0;' : ''}`}
        />
      ))
    }

    {
      SQUARES.map(({ x, y, side, reads }) => (
        <span
          class="hero__cell absolute"
          style={`left:${pctX(x)};top:${pctY(y)};width:${pctX(side)};aspect-ratio:1`}
          data-hero-cell
        >
          {reads && (
            <span class="hero__sample font-display tracking-tight text-paper" data-hero-sample>
              000 000 000
            </span>
          )}
        </span>
      ))
    }
    {/* Follows the pointer and reports whatever the footage is doing under it.
        Hidden until the pointer is over the hero, and never shown at all where
        there is no pointer to follow. */}
    <span class="hero__cursor hero__cell" data-hero-cursor>
      <span class="hero__sample font-display tracking-tight text-paper" data-hero-sample>
        000 000 000
      </span>
    </span>
  </div>

  <div class="relative flex flex-col items-center gap-2 px-gutter text-center text-paper">
    <h1 class="font-display text-hero leading-none">{hero.wordmark}</h1>

    {/* Retargeted by hero-cycle as the footage changes, so the link always
        names the experiment currently on screen. */}
    <a
      href={hero.clips[0].href}
      class="font-display text-copy leading-[1.667] tracking-tight"
      aria-label={`Go to ${hero.clips[0].label}`}
      data-hero-link
      data-module="hover-scramble"
    >
      → Go to <span data-scramble-text>{hero.clips[0].label}</span>
    </a>
  </div>

  {/* Watched by the header so it knows when the hero has been scrolled past. */}
  <span class="absolute inset-x-0 bottom-0 h-px" data-header-sentinel aria-hidden="true"></span>
</section>

<style>
  /* The clips are stacked and cross-faded in place. Only the first is opaque
     until the script takes over, so the hero looks right with JS unavailable. */
  .hero__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .hero__clip:first-of-type,
  .hero__clip.is-active {
    opacity: 1;
  }

  /* The squares are open windows, not panes: an outline, whatever the footage
     is doing behind them, and the reading taken from it underneath. */
  .hero__cell {
    border: 1px solid rgba(255, 255, 255, 0.55);
    will-change: transform;
  }

  .hero__sample {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    font-size: 0.625rem;
    line-height: 1.4;
    white-space: nowrap;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* Below the desktop layout the seams are narrow, crowded and sitting on the
     slowest GPUs of the lot: the blur comes off and the readouts come out. */
  /* The one being carried is a shade brighter than the ones left running. */
  .hero__cursor {
    border-color: rgba(255, 255, 255, 0.8);
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    opacity: 0;
    pointer-events: none;
  }

  /* No pointer to follow, and the readings under the squares are too small to
     be worth the room: both come off. */
  @media (hover: none), (max-width: 64rem) {
    .hero__cursor {
      display: none;
    }

    .hero__sample {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cell {
      will-change: auto;
    }
  }

</style>
