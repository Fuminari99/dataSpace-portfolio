---
import SectionLabel from '../ui/SectionLabel.astro';
import SamplerSquare from '../ui/SamplerSquare.astro';
import { concept } from '../../data/home';

interface Props {
  /** Anchor target, matching the hash the header and footer links use. */
  id?: string;
}

const { id } = Astro.props;
---

<section id={id} class="w-full scroll-mt-32 px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col items-center gap-8">
    <div class="flex w-full max-w-[608px] flex-col gap-6">
      <SectionLabel label={concept.label} variant="heading" />

      <p class="prose-justified font-body text-copy leading-[1.5]">{concept.lead}</p>
    </div>

    <div class="flex w-full flex-col items-center gap-8">
      <div
        class="relative w-full max-w-[608px] bg-panel"
        data-module="hero-cells"
        data-drift-x="200"
        data-drift-y="100"
        data-lightbox
      >
        <img
          class="aspect-[604/375] h-full w-full object-cover"
          src={concept.still}
          alt={concept.alt}
          loading="lazy"
          decoding="async"
          data-hero-still
        />

        <SamplerSquare top="40%" left="45%" />
      </div>

      <div class="flex w-full max-w-[608px] flex-col gap-6">
        <p class="prose-justified font-body text-copy leading-[1.5]">{concept.body}</p>

        <a
          href={concept.link.href}
          class="font-display text-copy leading-[1.667] tracking-tight"
          aria-label="Read about the project concept: Fractal Glass"
          data-module="hover-scramble"
        >
          → <span data-scramble-text>{concept.link.label}</span>
        </a>
      </div>
    </div>
  </div>
</section>
