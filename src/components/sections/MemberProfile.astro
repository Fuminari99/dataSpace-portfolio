---
import { members, type Member } from '../../data/site';

interface Props {
  member: Member;
  /** Anchor target, matching the hash the footer and header links use. */
  id?: string;
}

const { member, id } = Astro.props;

// The About frame repeats the three names above every profile, with the one
// being read at full opacity and the other two dimmed. Rendering the dimmed
// pair as links is what makes the repetition useful rather than decorative:
// it jumps straight down the page to that person. Once the profiles are stacked
// only the first list is left on screen, and it becomes the control for all
// three — which is why every name is a link here rather than the current one
// being inert.
const anchorFor = (name: string) => `#${name.toLowerCase()}`;
---

<section id={id} class="w-full scroll-mt-32 px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col items-center">
    <div class="flex w-full flex-col items-center gap-8 lg:flex-row lg:justify-center lg:gap-[108px]">
      <div class="flex shrink-0 items-center justify-center py-6">
        <img
          src={member.portrait}
          alt={`${member.name}'s portrait mark`}
          class="size-[208px] object-contain"
          width="208"
          height="208"
          loading="lazy"
          decoding="async"
          data-stack-portrait
        />
      </div>

      <div class="flex w-full flex-col gap-4 lg:max-w-[504px]">
        <nav class="stack-tabs flex gap-4" aria-label="The three of us" data-stack-tabs>
          {
            members.map((entry) => (
              <a
                href={anchorFor(entry.name)}
                class:list={[
                  'stack-tab font-body text-copy tracking-tight whitespace-nowrap',
                  { 'is-active': entry.name === member.name },
                ]}
                aria-current={entry.name === member.name ? 'true' : undefined}
                aria-label={`Read about ${entry.name}`}
                data-stack-tab
              >
                [ {entry.name} ]
              </a>
            ))
          }
        </nav>

        <div class="flex flex-col gap-4" data-stack-bio>
          {
            member.bio.map((paragraph) => (
              <p class="prose-justified font-body text-copy leading-copy" data-stack-line>
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The name being read is at full strength and the other two are dimmed; that
     difference is the only thing the list does when the profile changes. */
  .stack-tab {
    opacity: 0.5;
  }

  .stack-tab.is-active {
    opacity: 1;
  }
</style>
