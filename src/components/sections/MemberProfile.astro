---
import type { Member } from '../../data/site';

interface Props {
  member: Member;
  /** Anchor target, matching the hash the footer and header links use. */
  id?: string;
}

const { member, id } = Astro.props;

// All three are read at once, side by side, so a panel only needs to name the
// person it is carrying: the name heads the column, the portrait sits under it
// and the paragraphs follow. The portrait is sized by the padding around it
// rather than on the image itself, so the three columns keep the same box
// whatever the artwork is.
---

<article id={id} class="flex w-full scroll-mt-32 flex-col items-center gap-8">
  <h3 class="font-display text-body tracking-tight whitespace-nowrap">[ {member.name} ]</h3>

  <div class="w-[288px] max-w-full px-12 py-4">
    <img
      src={member.portrait}
      alt={`${member.name}'s portrait mark`}
      class="w-full object-cover object-bottom"
      width="288"
      height="288"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="flex w-full max-w-[420px] flex-col gap-4">
    {
      member.bio.map((paragraph) => (
        <p class="prose-justified font-body text-copy leading-copy">{paragraph}</p>
      ))
    }
  </div>
</article>
