---
// Six tiles in two columns. The middle row is the pair of accent gradients that
// run outward from each edge; the rest are plain surface panels.
const tiles = [
  { accent: false, flipped: false },
  { accent: false, flipped: false },
  { accent: true, flipped: false },
  { accent: true, flipped: true },
  { accent: false, flipped: false },
  { accent: false, flipped: false },
];
---

<section class="w-full px-gutter py-section">
  <ul
    class="mx-auto grid max-w-page grid-cols-2 gap-x-16 gap-y-16 lg:gap-x-[37.0625rem] lg:gap-y-[6.4375rem]"
  >
    {
      tiles.map((tile) => (
        <li
          class:list={[
            'aspect-[319.5/285]',
            tile.accent ? 'tile--accent' : 'bg-surface',
            tile.accent && tile.flipped && 'rotate-180',
          ]}
        />
      ))
    }
  </ul>
</section>

<style>
  .tile--accent {
    /* The transparent stop carries the surface colour so the midpoint does not
       dull towards grey the way a transparent-black stop would. */
    background-image: linear-gradient(
      to left,
      rgb(247 247 247 / 0) 0%,
      var(--color-accent) 126.84%
    );
  }
</style>
