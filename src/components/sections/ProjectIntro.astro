---
import ProseSection from './ProseSection.astro';

interface Props {
  /** Anchor target, matching the hash the header and footer links use. */
  id?: string;
}

const { id } = Astro.props;

// The brief asks that the archive be self-explanatory to someone who was not in
// the room, so the home page opens by saying what the project was before it
// shows anything made in it. About goes into the brief itself.
const lead =
  'Data Spaces is a three-week project on the BA Design Communication course at LASALLE College of the Arts, run across nine sessions. This site is its archive.';

const columns = [
  'Data is collected about us constantly, and it is usually treated as a technical matter — something to be captured, stored and analysed rather than designed. The brief turns that around and asks what a designer can do with it: how raw data is gathered, quantified, given a form, and read by someone else.',
  'Each session hands out a brief that has to be answered before the next one, so the work is made quickly and on the spot. Four experiments came out of it, and they build on each other: the counts taken by hand in the first one are still the material being turned over in the last.',
];
---

<ProseSection label="BACKGROUND" id={id} lead={lead} columns={columns} />
