---
import VisualFigure from '../ui/VisualFigure.astro';
import { members } from '../../data/site';

export interface Tab {
  /** Doubles as the anchor target for the matching footer link. */
  id: string;
  label: string;
  description?: string;
  /** Caption value per member, in `members` order. */
  values?: string[];
  /** Per-member clips; a slot left undefined falls back to the still. */
  visuals?: (string | undefined)[];
}

interface Props {
  tabs: Tab[];
  /** Names the group for assistive tech when there is more than one. */
  label?: string;
}

const { tabs, label = 'Recordings' } = Astro.props;
const isTabbed = tabs.length > 1;
---

{/* The frame sets the rhythms out one under the other rather than behind a set
    of tabs: every recording is on the page, and the list of names above each
    one marks which is being read while doubling as a jump to the others. The
    account of how it was recorded is folded away behind "More". */}
<section class="w-full">
  {
    tabs.map((tab, index) => (
      <div
        id={tab.id}
        class:list={[
          'w-full scroll-mt-32 px-gutter',
          index === 0 ? 'py-section' : 'pb-section',
        ]}
      >
        <div class="mx-auto flex max-w-page flex-col gap-4">
          <div class="rhythm__row flex w-full items-end justify-between gap-8">
            {isTabbed ? (
              <nav class="flex flex-wrap gap-4" aria-label={label}>
                {tabs.map((other) =>
                  other.id === tab.id ? (
                    <span
                      class="font-body text-body tracking-tight whitespace-nowrap"
                      aria-current="true"
                    >
                      [ {other.label} ]
                    </span>
                  ) : (
                    <a
                      href={`#${other.id}`}
                      class="font-body text-body tracking-tight whitespace-nowrap opacity-50"
                      aria-label={`Go to ${other.label}`}
                    >
                      [ {other.label} ]
                    </a>
                  )
                )}
              </nav>
            ) : (
              <span class="font-body text-body tracking-tight whitespace-nowrap">
                [ {tab.label} ]
              </span>
            )}

            {tab.description && (
              <details class="rhythm__more">
                <summary
                  class="font-body text-label leading-[1.5]"
                  aria-controls={`${tab.id}-description`}
                >
                  More
                </summary>
              </details>
            )}
          </div>

          {tab.description && (
            <p
              id={`${tab.id}-description`}
              class="rhythm__description prose-justified max-w-[560px] font-body text-body tracking-tight"
            >
              {tab.description}
            </p>
          )}

          <div class="flex flex-col items-center justify-between gap-12 md:flex-row md:gap-8">
            {members.map((member, memberIndex) => (
              <VisualFigure
                src={member.visual}
                video={tab.visuals?.[memberIndex]}
                poster={tab.visuals?.[memberIndex]?.replace(/\.mp4$/, '.jpg')}
                alt={`${tab.label} visualisation by ${member.name}`}
                name={member.name}
                value={tab.values?.[memberIndex]}
                class="w-full max-w-[320px]"
              />
            ))}
          </div>
        </div>
      </div>
    ))
  }
</section>

<style>
  /* A disclosure with nothing inside it: what it opens is the paragraph that
     follows the row, which has to sit outside so it can run the full measure
     rather than being squeezed into the right-hand cell. */
  .rhythm__more {
    flex: none;
  }

  .rhythm__more summary {
    cursor: pointer;
    list-style: none;
  }

  .rhythm__more summary::-webkit-details-marker {
    display: none;
  }

  .rhythm__description {
    display: none;
  }

  .rhythm__row:has(details[open]) + .rhythm__description {
    display: block;
  }
</style>
