---
import SectionLabel from '../ui/SectionLabel.astro';
import VisualFigure from '../ui/VisualFigure.astro';
import { members } from '../../data/site';

interface Props {
  label: string;
  /** Anchor target, matching the hash the footer link uses. */
  id?: string;
  /** Copy that stays on screen while the visuals move past it. */
  lead?: string;
  /** One clip per member, in `members` order; an undefined slot falls back to the still. */
  visuals?: (string | undefined)[];
}

const { label, id, lead, visuals } = Astro.props;
---

<section class="w-full px-gutter py-section">
  <div
    class="mx-auto flex max-w-page flex-col gap-8 lg:flex-row lg:items-start lg:gap-16"
    data-module="sticky-label"
  >
    {/*
      Two boxes: a viewport-tall sticky track, and the label travelling down it.
      The track's top starts at the row's top and its bottom ends at the row's
      bottom, so `sticky-label` moving the label from one end of it to the other
      over the length of the scroll lands it level with the first visual before
      anything has moved, through the middle while the column is passing, and
      level with the last visual at the end. `self-start` is what gives the
      sticky element a shorter box than the row, without which there would be
      nothing for it to travel within. With the script gone the label simply
      sits at the top of the track.
    */}
    <div
      class="lg:sticky lg:top-0 lg:h-svh lg:w-[496px] lg:shrink-0 lg:self-start"
      data-sticky-track
    >
      <div class="flex flex-col gap-6" data-sticky-content data-reveal>
        <SectionLabel label={label} id={id} />

        {
          lead && (
            <p class="prose-justified font-body text-body-lg tracking-tight">{lead}</p>
          )
        }
      </div>
    </div>

    <div class="flex w-full flex-col gap-16">
      {
        members.map((member, index) => (
          <VisualFigure
            src={member.visual}
            video={visuals?.[index]}
            poster={visuals?.[index]?.replace(/\.mp4$/, '.webp')}
            alt={`${label} still by ${member.name}`}
            name={member.name}
            ratio="video"
            class="w-full"
          />
        ))
      }
    </div>
  </div>
</section>
