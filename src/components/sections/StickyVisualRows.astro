---
import SectionLabel from '../ui/SectionLabel.astro';
import VisualFigure from '../ui/VisualFigure.astro';
import { members } from '../../data/site';

interface Props {
  label: string;
  /** Anchor target, matching the hash the footer link uses. */
  id?: string;
  /** Copy that stays on screen while the visuals move past it. */
  lead?: string;
  /** One clip per member, in `members` order; an undefined slot falls back to the still. */
  visuals?: (string | undefined)[];
}

const { label, id, lead, visuals } = Astro.props;
---

<section class="w-full px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col gap-8 lg:flex-row lg:items-start lg:gap-16">
    {/*
      Held in the middle of the viewport for the length of the column beside it,
      so the reading stays put while the visuals it describes move past.
      `self-start` is what gives the sticky element a shorter box than the row,
      without which there is nothing for it to travel within. Centring is done
      by giving the sticky box the full viewport height and flex-centring its
      content inside it, rather than a `top-1/2` + `-translate-y-1/2` transform:
      that transform applies unconditionally, including before the box is
      actually pinned, which pulled the label up out of place the moment the
      section came on screen. A flex-centred `h-svh` box reads the same whether
      it is stuck or still sitting in normal flow.
    */}
    <div class="flex flex-col gap-6 lg:sticky lg:top-0 lg:h-svh lg:w-[496px] lg:shrink-0 lg:justify-center lg:self-start" data-reveal>
      <SectionLabel label={label} id={id} />

      {
        lead && (
          <p class="prose-justified font-body text-body-lg tracking-tight">{lead}</p>
        )
      }
    </div>

    <div class="flex w-full flex-col gap-16">
      {
        members.map((member, index) => (
          <VisualFigure
            src={member.visual}
            video={visuals?.[index]}
            poster={visuals?.[index]?.replace(/\.mp4$/, '.webp')}
            alt={`${label} still by ${member.name}`}
            name={member.name}
            ratio="video"
            class="w-full"
          />
        ))
      }
    </div>
  </div>
</section>
