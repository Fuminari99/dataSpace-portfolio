---
import SectionLabel from '../ui/SectionLabel.astro';
import { background } from '../../data/home';
import SamplerSquare from '../ui/SamplerSquare.astro';

// The two blocks either side of the column are the intro clips, read the way
// the hero reads its own footage: a framed panel that reports the average
// colour of what is playing inside it.
//
// Both are pinned to the section's own `py-28` rather than to a measured
// offset, so they stay level with the column as the copy reflows: the first
// clip's top edge meets the heading, and the second one's bottom edge meets the
// last line of the last paragraph.
const positions = ['top-28 right-[3%]', 'bottom-28 left-[4%]'];

const panels = background.intros.map((intro, index) => ({
  position: positions[index],
  video: intro.video,
  poster: intro.video.replace(/\.mp4$/, '.webp'),
  alt: intro.alt,
}));

interface Props {
  /** Anchor target, matching the hash the header and footer links use. */
  id?: string;
}

const { id } = Astro.props;
---

<section id={id} class="relative mt-28 w-full scroll-mt-32 overflow-hidden px-gutter py-28">
  {/* The two blocks either side of the column, in the frame's own positions. */}
  {/* The two panels need the column of text plus 272px either side of it —
      1136px, and a little air. Gate at 1280 so they never sit under the copy. */}
  <div class="pointer-events-none absolute inset-0 hidden min-[1280px]:block" aria-hidden="true">
    {
      panels.map((panel) => (
        <figure
          class:list={['sampler absolute w-[272px]', panel.position]}
          data-reveal
          data-module="hero-cells"
          data-drift-x="124"
          data-drift-y="72"
        >
          {/* The panel is fixed; the square is what moves over it, reading the
              colour of whatever it happens to be sitting on. */}
          <div class="sampler__frame relative h-[168px] w-full">
            <video
              class="h-full w-full object-cover"
              data-module="lazy-video"
              data-hero-clip
              data-poster={panel.poster}
              muted
              loop
              playsinline
              preload="none"
            >
              <source data-src={panel.video} type="video/mp4" />
            </video>

            <SamplerSquare top="56px" left="108px" />
          </div>
        </figure>
      ))
    }
  </div>

  <div class="relative mx-auto flex max-w-page flex-col items-center gap-12">
    <div data-reveal><SectionLabel label={background.label} variant="heading" /></div>

    <div class="flex w-full max-w-[592px] flex-col gap-16">
      {
        background.columns.map((paragraph) => (
          <p class="prose-justified font-body text-copy leading-[1.5]" data-reveal>
            {paragraph}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The panel is the footage and nothing else; the square is the only drawn
     thing over it, and it is free to wander a little past the edges. */
  .sampler__frame {
    overflow: visible;
  }


</style>
