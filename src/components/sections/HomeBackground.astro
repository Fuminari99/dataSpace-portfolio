---
import SectionLabel from '../ui/SectionLabel.astro';
import { background } from '../../data/home';
import { experiments } from '../../data/experiments';
import SamplerSquare from '../ui/SamplerSquare.astro';

// The two blocks either side of the column are the experiments themselves,
// read the way the hero reads its own footage: a framed panel that reports the
// average colour of what is playing inside it.
const panels = [
  { experiment: experiments[1], position: 'top-20 right-[3%]' },
  { experiment: experiments[3], position: 'top-[376px] left-[4%]' },
].map(({ experiment, position }) => ({
  position,
  video: experiment.video,
  poster: experiment.video.replace(/\.mp4$/, '.webp'),
  alt: `${experiment.title} — a clip from the experiment`,
}));

interface Props {
  /** Anchor target, matching the hash the header and footer links use. */
  id?: string;
}

const { id } = Astro.props;
---

<section id={id} class="relative w-full scroll-mt-32 overflow-hidden px-gutter py-section">
  {/* The two blocks either side of the column, in the frame's own positions. */}
  <div class="pointer-events-none absolute inset-0 hidden xl:block" aria-hidden="true">
    {
      panels.map((panel) => (
        <figure
          class:list={['sampler absolute w-[272px]', panel.position]}
          data-module="hero-cells"
          data-drift-x="124"
          data-drift-y="72"
        >
          {/* The panel is fixed; the square is what moves over it, reading the
              colour of whatever it happens to be sitting on. */}
          <div class="sampler__frame relative h-[168px] w-full">
            <video
              class="h-full w-full object-cover"
              data-module="lazy-video"
              data-hero-clip
              data-poster={panel.poster}
              muted
              loop
              playsinline
              preload="none"
            >
              <source data-src={panel.video} type="video/mp4" />
            </video>

            <SamplerSquare top="56px" left="108px" />
          </div>
        </figure>
      ))
    }
  </div>

  <div class="relative mx-auto flex max-w-page flex-col items-center gap-12">
    <SectionLabel label={background.label} variant="heading" />

    <div class="flex w-full max-w-[592px] flex-col gap-16">
      {
        background.columns.map((paragraph) => (
          <p class="prose-justified font-body text-copy leading-[1.5]">{paragraph}</p>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The panel is the footage and nothing else; the square is the only drawn
     thing over it, and it is free to wander a little past the edges. */
  .sampler__frame {
    overflow: visible;
  }


</style>
