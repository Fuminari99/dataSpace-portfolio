---
import { experiments } from '../../data/experiments';
import { experimentThumbs } from '../../data/home';
import { nav } from '../../data/site';

interface Props {
  /** Anchors for each row, in experiment order, so the header links land here. */
  ids?: (string | undefined)[];
}

const { ids = [] } = Astro.props;

const rows = experiments.map((experiment, index) => ({
  experiment,
  id: ids[index],
  name: `Experiment${String(index + 1).padStart(2, '0')}`,
  longLabel: nav.find((item) => item.href === experiment.href)?.longLabel ?? experiment.title,
  thumbs: experimentThumbs[experiment.href] ?? [],
}));
---

<section class="w-full px-gutter py-section">
  <ul class="rows mx-auto w-full max-w-page border-b border-list-rule" data-module="experiment-rows">
    {
      rows.map(({ experiment, id, name, longLabel, thumbs }) => (
        <li
          id={id}
          class="row scroll-mt-32 border-t border-list-rule"
          data-row
        >
          <p class="row__name font-display text-copy leading-[1.5] tracking-tight">{name}</p>

          <div class="row__body">
            <div class="row__media">
              {thumbs.map((image) => (
                <div class="row__frame" style={`background-color:${image.tint}`}>
                  <img
                    src={image.src.replace(/\.webp$/, '-288.webp')}
                    alt={image.alt}
                    width="144"
                    height="144"
                    loading="lazy"
                    decoding="async"
                    data-row-media
                  />
                </div>
              ))}
            </div>

            <div class="row__copy">
              {/* The row is named by the display type above; this keeps the
                  experiment's own title in the outline without repeating it. */}
              <h3 class="sr-only">{experiment.title}</h3>

              <p class="prose-justified font-body text-label leading-[1.5]">
                {experiment.overview[0]}
              </p>

              <a
                href={experiment.href}
                class="row__link font-display text-caption leading-[1.8] tracking-tight"
                aria-label={`Read ${longLabel}: ${experiment.title}`}
                data-module="hover-scramble"
              >
                → <span data-scramble-text>{longLabel}</span>
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* The two heights the script tweens between. A row is either the one being
     read, or a name waiting to be pointed at. */
  .rows {
    /* An open row is the 144px thumbnails plus the 16px above and below them;
       a shut one is the name on its own. The frame sets both against the name,
       which sits beside the media rather than above it. */
    --row-open: 176px;
    --row-shut: 48px;
  }

  .row {
    position: relative;
    overflow: hidden;
    padding-inline: 24px;
    display: flex;
    align-items: flex-start;
    gap: 32px;
    /* Grow and shrink are fixed here so the script only ever tweens the basis,
       which is a single interpolable length rather than a shorthand. */
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: var(--row-shut);
  }

  .row__name {
    /* Matches --row-shut, so a closed row shows its name and nothing else. */
    display: flex;
    flex: none;
    align-items: center;
    height: var(--row-shut);
  }

  /* Ranged right rather than centred: the rows carry two, three or four
     thumbnails between them, and centring each row's own group would leave the
     copy — and the images beside it — landing in a different place on every
     row. Against the right edge all four line up. */
  .row__body {
    display: flex;
    flex: 1 1 0;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 32px;
    padding-block: 16px;
  }

  /* Each thumbnail rides up into its own frame, so it is clipped by the frame
     rather than sliding over the row above. */
  .row__media {
    display: flex;
    flex: none;
    gap: 32px;
  }

  /* The background is the image's own average colour, set from the data, so a
     frame holds the shade of the thumbnail that is about to load in it. */
  .row__frame {
    width: 144px;
    height: 144px;
    overflow: hidden;
  }

  .row__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fixed rather than capped, so the column's own edges are the same on every
     row whatever the copy in it runs to. */
  .row__copy {
    display: flex;
    width: 440px;
    flex: none;
    flex-direction: column;
    gap: 24px;
  }

  /* Without the script the list is four open rows — every row's copy readable,
     nothing depending on a pointer. The rules below only take effect once the
     script has marked the rows up, and are undone if it is torn down. */
  .rows:has([data-row][data-open]) {
    display: flex;
    flex-direction: column;
    height: calc(var(--row-open) + 3 * var(--row-shut));
  }

  /* The media and copy sit beside the name rather than under it, so a shut row
     would otherwise show the top slice of both. The frame shows a shut row as
     its name alone. */
  .rows:has([data-row][data-open]) .row[data-open='false'] .row__body {
    visibility: hidden;
  }

  /* The open row is being read as one thing, so it is one target: the link at
     the end of the copy is stretched over the whole row. The label keeps the
     accessible name, so this changes where the row can be clicked and nothing
     about what it announces. */
  .row__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (max-width: 64rem) {
    /* Not enough width for the media and the copy side by side, and no pointer
       to open a row with on most of these screens: the list stays open. */
    .rows:has([data-row][data-open]) {
      display: block;
      height: auto;
    }

    .row {
      flex-basis: auto !important;
      flex-direction: column;
      gap: 0;
    }

    .row__name {
      height: auto;
      padding-block: 16px;
    }

    .row__body {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0;
    }

    .row__copy {
      width: 100%;
    }

    .row__media {
      flex-wrap: wrap;
    }
  }
</style>
