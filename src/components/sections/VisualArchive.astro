---
import { archive } from '../../data/archive';
---

<section class="w-full py-section">
  <div class="mx-auto flex max-w-page flex-col gap-32 px-gutter lg:px-[144px]">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row">
      <h2 class="font-display text-h3 tracking-tight whitespace-nowrap">Visual Archive</h2>

      <div class="prose-justified flex max-w-[608px] flex-col font-body text-body tracking-tight">
        <p>An accumulation of recorded moments, translated into form.</p>
        <p>
          Across analogue and computational processes, data is collected, rearranged and
          transformed, revealing the variations through which each visual language emerges.
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-x-16 gap-y-24 sm:grid-cols-3 lg:gap-x-56 lg:gap-y-36">
      {
        archive.map((tile) => (
          <li>
            <a href={tile.href} class="flex flex-col gap-2" data-module="hover-scramble">
              <div class="aspect-square w-full overflow-hidden bg-surface">
                <video
                  class="h-full w-full object-cover"
                  data-module="lazy-video"
                  poster={tile.video.replace(/\.mp4$/, '.webp')}
                  role="img"
                  aria-label={tile.alt}
                  muted
                  loop
                  playsinline
                  preload="none"
                >
                  <source data-src={tile.video} type="video/mp4" />
                </video>
              </div>

              <span class="font-body text-label tracking-tight opacity-50" data-scramble-text>
                {tile.caption}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
