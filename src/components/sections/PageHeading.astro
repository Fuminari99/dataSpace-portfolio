---
interface Props {
  /** Eyebrow above the title, e.g. "[EX.01]". Omitted on the About page. */
  eyebrow?: string;
  title: string;
  /** Anchor target, matching the hash the footer link uses. */
  id?: string;
  /** One or two columns of intro copy. */
  intro?: string[];
  /**
   * Sets the intro in the Projects frame's own measure — one narrow column of
   * unjustified copy — rather than the pair of justified columns the experiment
   * pages run.
   */
  display?: boolean;
  /**
   * The About frame uses a single wide column of intro copy.
   */
  singleColumn?: boolean;
  /** Centre the title and intro within the page grid. */
  centred?: boolean;
}

const { eyebrow, title, id, intro = [], display = false, singleColumn = false, centred = false } = Astro.props;
---

{/* Every page opens on a band of the same height, whatever the title and
    intro in it run to, so the first screen reads the same from page to page.
    The block sits in the middle of it rather than at the top edge. */}
<section
  id={id}
  class="flex min-h-[60svh] w-full scroll-mt-32 flex-col justify-center border-b border-rule px-gutter py-section"
>
  <div class:list={['mx-auto flex w-full max-w-page flex-col gap-8', centred ? 'items-center text-center' : 'text-left']}>
    <div class:list={['flex flex-col gap-4', centred ? 'items-center' : 'items-start']}>
      {eyebrow && <p class="font-display text-body tracking-tight">{eyebrow}</p>}
      {/* Every page title is set the same way — the display face at the frame's
          own weight. `display` and `singleColumn` only decide what happens to the
          intro underneath it. */}
      <h1 class="font-display text-h1 leading-[1.2] tracking-tight">{title}</h1>
    </div>

    {/* The heading itself resolves out of `heading-scramble`; the copy under it
        settles in with everything else on the page — marked once, on the
        block, so the paragraphs arrive together rather than one after the
        other. */}
    {
      intro.length > 0 &&
        (singleColumn ? (
          <div class="flex flex-col gap-6" data-reveal>
            {intro.map((paragraph) => (
              <p class="max-w-[888px] font-display text-copy leading-copy">{paragraph}</p>
            ))}
          </div>
        ) : (
          <div
            data-reveal
            class:list={[
              'flex flex-col gap-6',
              display ? 'md:flex-row md:gap-[56px]' : 'md:flex-row',
            ]}
          >
            {intro.map((paragraph) => (
              <p
                class:list={[
                  'font-body',
                  display
                    ? 'max-w-[496px] text-copy leading-copy'
                    : 'max-w-[496px] text-body tracking-tight',
                ]}
              >
                {paragraph}
              </p>
            ))}
          </div>
        ))
    }
  </div>
</section>
