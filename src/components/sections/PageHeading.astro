---
interface Props {
  /** Eyebrow above the title, e.g. "[EX.01]". Omitted on the About page. */
  eyebrow?: string;
  title: string;
  /** Anchor target, matching the hash the footer link uses. */
  id?: string;
  /** One or two columns of intro copy. */
  intro?: string[];
}

const { eyebrow, title, id, intro = [] } = Astro.props;
---

<section id={id} class="w-full scroll-mt-32 border-b border-rule px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col gap-8">
    <div class="flex flex-col gap-4">
      {eyebrow && <p class="font-display text-body tracking-tight">{eyebrow}</p>}
      <h1 class="font-body text-h1 font-bold tracking-tight">{title}</h1>
    </div>

    {
      intro.length > 0 && (
        <div class="flex flex-col gap-6 md:flex-row">
          {intro.map((paragraph) => (
            <p class="prose-justified max-w-[31.1875rem] font-body text-body tracking-tight">
              {paragraph}
            </p>
          ))}
        </div>
      )
    }
  </div>
</section>
