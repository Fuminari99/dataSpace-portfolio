---
import { experiments } from '../../data/experiments';
import HeroMediaTreatment from '../ui/HeroMediaTreatment.astro';

interface Props {
  /** Home-page anchors so header / footer section links still land on each clip. */
  ids?: (string | undefined)[];
}

const { ids = [] } = Astro.props;

// Four linked clips. Rest label is short ("EX01"); hover scrambles to the
// formal title with an arrow, and widens that column so the four shares of the
// strip rebalance. On About it fills whatever remains of the tools + strip
// block; on Home it sits under the concept at a fixed minimum height.
const panels = experiments.map((experiment, index) => ({
  ...experiment,
  id: ids[index],
  shortLabel: `EX0${index + 1}`,
  hoverLabel: `→ ${experiment.title}`,
  poster: experiment.video.replace(/\.mp4$/, '.webp'),
}));
---

{/* The strip arrives as one band rather than four, so the four clips are not
    read as four separate things landing. `data-reveal` is inert unless a page
    mounts the reveal module around it, which is why About is unaffected. */}
<section
  class="experiment-strip-section flex min-h-[280px] w-full flex-col lg:min-h-[360px] lg:flex-1"
  data-reveal
>
  {/* One panel per row on a phone — side by side the four clips are too small
      to read — two up from the tablet, and the widening strip on desktop. */}
  <ul
    class="experiment-strip grid min-h-[280px] w-full flex-1 grid-cols-1 md:grid-cols-2 lg:flex lg:min-h-[360px]"
    data-module="nav-scramble"
  >
    {
      panels.map((panel, index) => (
        <li
          id={panel.id}
          class="experiment-strip__item min-h-0 min-w-0 scroll-mt-32"
          data-nav-item
          data-exp={`ex0${index + 1}`}
        >
          <a
            class="experiment-strip__link relative block h-full min-h-[200px] w-full overflow-hidden lg:min-h-0"
            href={panel.href}
            aria-label={`Go to ${panel.shortLabel}: ${panel.title}`}
            data-nav-link
            data-label={panel.shortLabel}
            data-hover-label={panel.hoverLabel}
          >
            <div class="absolute inset-0">
              <HeroMediaTreatment blur={0} scale={1}>
                <video
                  class="h-full w-full object-cover"
                  data-module="lazy-video"
                  data-poster={panel.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                >
                  <source data-src={panel.video} type="video/mp4" />
                </video>
              </HeroMediaTreatment>
            </div>
            <span
              class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center px-4 text-center font-display text-body tracking-tight text-paper"
              data-nav-text
              aria-hidden="true"
            >
              {panel.shortLabel}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .experiment-strip__item {
    min-width: 0;
  }

  /* Less grain than the hero so the sharp clips stay readable as a strip. */
  .experiment-strip__item :global(.media-frame__grain) {
    opacity: 0.35;
  }

  @media (min-width: 64rem) {
    .experiment-strip__item {
      flex-grow: 1;
      flex-shrink: 1;
      flex-basis: 0;
      transition: flex-grow 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .experiment-strip__item:hover,
    .experiment-strip__item:focus-within,
    .experiment-strip__item.is-open {
      flex-grow: 4.5;
    }

    /* Unhovered / unopened siblings narrow so their labels mostly clip. */
    .experiment-strip:has(.experiment-strip__item:hover) .experiment-strip__item:not(:hover),
    .experiment-strip:has(.experiment-strip__item:focus-within) .experiment-strip__item:not(:focus-within),
    .experiment-strip.is-strip-filtered .experiment-strip__item:not(.is-open) {
      flex-grow: 0.45;
    }

    .experiment-strip__item :is([data-nav-text]) {
      transition: opacity 0.45s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .experiment-strip:has(.experiment-strip__item:hover) .experiment-strip__item:not(:hover) :is([data-nav-text]),
    .experiment-strip:has(.experiment-strip__item:focus-within) .experiment-strip__item:not(:focus-within) :is([data-nav-text]),
    .experiment-strip.is-strip-filtered .experiment-strip__item:not(.is-open) :is([data-nav-text]) {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experiment-strip__item,
    .experiment-strip__item :is([data-nav-text]) {
      transition: none;
    }
  }
</style>
