---
import { experiments } from '../../data/experiments';
import HeroMediaTreatment from '../ui/HeroMediaTreatment.astro';

// Four linked stills with the home hero's treatment and labels over the media.
const panels = experiments.map((experiment, index) => ({
  ...experiment,
  label: `EX0${index + 1}`,
  poster: experiment.video.replace(/\.mp4$/, '.webp'),
}));
---

<section class="w-full">
  <ul class="flex w-full">
    {
      panels.map((panel) => (
        <li class="min-w-0 flex-1">
          <a class="relative block h-[320px] w-full lg:h-[688px]" href={panel.href} aria-label={`Go to ${panel.label}: ${panel.title}`}>
            <HeroMediaTreatment>
            <img
              src={panel.poster}
              alt=""
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            </HeroMediaTreatment>
            <span class="pointer-events-none absolute inset-0 flex items-center justify-center font-display text-body tracking-tight text-white">{panel.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

</section>
