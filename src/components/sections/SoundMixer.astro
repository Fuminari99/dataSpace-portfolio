---
import SectionLabel from '../ui/SectionLabel.astro';
interface Props { label: string; id: string; lead: string; more: string | string[]; tracks: {src: string; label: string; source: string; value?: string; mixed?: boolean}[]; figures: {src: string; alt: string}[] }
const { label, id, lead, more, tracks, figures } = Astro.props;
---
<section class="mixer w-full px-gutter" aria-labelledby={id} data-module="sound-mixer">
  <div class="mixer__content mx-auto max-w-page">
    <SectionLabel label={label} id={id} as="h2" />
    <div class="mixer__intro" data-reveal><p>{lead}</p><div class="mixer__more">{[more].flat().map((paragraph) => <p>{paragraph}</p>)}</div></div>
    <div class="mixer__transport" data-reveal>
      <button type="button" data-play aria-label="Play all tracks">▶ PLAY</button>
      <div class="mixer__timeline">
        <input type="range" min="0" max="100" value="0" step="0.1" aria-label="Seek all tracks" data-seek />
      </div>
    </div>
    <p class="mixer__status" role="status" data-status></p>
    <ol class="mixer__tracks">
      {tracks.filter(t => !t.mixed).map((track, i) => (
        <li data-reveal data-track data-src={track.src} data-title={track.label}>
          <div class="mixer__heading"><h3>{track.source} <span class="mixer__rhythm">- {track.label.toLowerCase().replace(/^./, c => c.toUpperCase())}</span></h3></div>
          <div class="mixer__scope"><canvas aria-hidden="true"></canvas></div>
          {/* No `data-lightbox`: these are TouchDesigner node screenshots read
              at the size they are set, not images to open. */}
          {figures[i] && <div class="mixer__image"><img src={figures[i].src} alt={figures[i].alt} loading="lazy" decoding="async" /></div>}
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .mixer { padding-block: var(--spacing-section); }
  .mixer__content { display: flex; flex-direction: column; }
  .mixer__intro { display: grid; grid-template-columns: 496fr 712fr; gap: 72px; margin-block: 16px 24px; font-size: var(--text-copy); line-height: 1.5; letter-spacing: var(--tracking-tight); }
  .mixer__intro > p:first-child { font-size: var(--text-body-lg); }
  .mixer__more { display: flex; flex-direction: column; gap: 16px; }
  .mixer__tracks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 24px; }
  .mixer__tracks li { min-width: 0; }
  .mixer__tracks li:hover .mixer__heading, .mixer__tracks li:focus-within .mixer__heading { opacity: 1; }
  .mixer__tracks:has(li:hover) li:not(:hover), .mixer__tracks:has(li:focus-within) li:not(:focus-within) { opacity: .35; }
  .mixer__heading { display: flex; align-items: baseline; gap: 12px; }
  .mixer__heading h3 { font-size: var(--text-body); }
  .mixer__rhythm { font-size: inherit; opacity: .5; }
  /* Each track sits over its own scope and still, so the name reads as a
     caption for that column rather than as the start of a list. */
  .mixer__heading { flex-wrap: wrap; justify-content: center; text-align: center; }
  .mixer__image { width: 100%; margin-top: 8px; }
  .mixer__image img { display: block; width: 100%; height: auto; }
  .mixer__scope { position: relative; margin-block: 16px 8px; }
  canvas { display: block; width: 100%; height: clamp(60px, 12svh, 120px); background: var(--color-paper); }
  button { cursor: pointer; min-height: 44px; font-size: var(--text-label); }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
  .mixer__transport { display: flex; flex-direction: column; gap: 8px; align-items: center; width: 100%; margin: 40px 0 0; }
  .mixer__timeline { position: relative; display: flex; align-items: center; width: min(280px, 80%); height: 24px; }
  .mixer__timeline::before, .mixer__timeline::after { content: ''; position: absolute; top: 50%; width: 1px; height: 10px; background: var(--color-rule); transform: translateY(-50%); pointer-events: none; }
  .mixer__timeline::before { left: 0; }
  .mixer__timeline::after { right: 0; }
  /* Set to match the track headings (Ocean / Footsteps / Seagulls). */
  .mixer__transport button { white-space: nowrap; font-size: var(--text-body); }
  input { display: block; appearance: none; width: 100%; margin: 0; height: 2px; background: var(--color-rule); min-width: 0; }
  input::-webkit-slider-thumb { appearance: none; height: 10px; width: 10px; background: var(--color-ink); }
  input::-moz-range-thumb { border: 0; border-radius: 0; height: 10px; width: 10px; background: var(--color-ink); }
  .mixer__status { font-size: var(--text-caption); margin-top: 8px; text-align: center; }
  @media(max-width: 767px) { .mixer__intro, .mixer__tracks { grid-template-columns: 1fr; gap: 32px; } }
</style>
