---
import SectionLabel from '../ui/SectionLabel.astro';
import { CANVAS, ROLE_SIZE, TYPE_CANVAS, collage } from '../../data/concept-collage';

interface Props {
  /** Anchor target, matching the hash the header and footer links use. */
  id?: string;
}

const { id } = Astro.props;

// Sizes are quoted against the design's 1280-wide frame; in container query
// units they hold their proportion as the canvas scales.
const cqw = (px: number) => `${((px / TYPE_CANVAS) * 100).toFixed(4)}cqw`;

/**
 * Stacked, the collage should read the way the scatter does: a picture, the
 * number that annotates it, the next picture. Below the breakpoint that is the
 * order it is laid out in, so this interleaves the two here rather than
 * reordering with CSS — the scatter is absolutely positioned, so document
 * order costs it nothing, and a screen reader gets the same sequence the page
 * shows. (Checked: no marker overlaps an image, so the paint order the swap
 * changes is not visible.)
 */
const prose = collage.filter((item) => item.kind === 'text' && item.role !== 'marker');
const markers = collage.filter((item) => item.kind === 'text' && item.role === 'marker');
const images = collage.filter((item) => item.kind === 'image');

const stacked = [
  ...prose,
  ...images.flatMap((image, index) => (markers[index] ? [image, markers[index]] : [image])),
  ...markers.slice(images.length),
];

const canvasStyle = [
  `--collage-heading:${cqw(ROLE_SIZE.heading)}`,
  `--collage-note:${cqw(ROLE_SIZE.note)}`,
  `--collage-marker:${cqw(ROLE_SIZE.marker)}`,
  `--canvas-ratio:${CANVAS.width}/${CANVAS.height}`,
].join(';');
---

<section id={id} class="w-full scroll-mt-32 px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col gap-4" data-reveal>
    <SectionLabel label="CONCEPT" />

    <div class="collage" style={canvasStyle} data-reveal>
      {
        stacked.map((item) =>
          item.kind === 'text' ? (
            <p
              class:list={[
                'collage__item',
                `is-${item.role}`,
                // Only the headings and the markers are tracked; the running
                // notes carry none in the library's own style.
                item.role === 'note' ? 'font-body' : 'tracking-tight',
                item.role === 'heading' && 'font-display',
                item.role === 'marker' && 'font-body',
              ]}
              style={`--x:${item.x};--y:${item.y};--w:${item.w}`}
            >
              {item.text}
            </p>
          ) : (
            <div
              class="collage__item collage__image"
              style={`--x:${item.x};--y:${item.y};--w:${item.w};--h:${item.h}`}
            >
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class:list={[item.crop && 'is-cropped']}
                style={
                  item.crop
                    ? `--crop-h:${item.crop.height};--crop-top:${item.crop.top};--crop-left:${item.crop.left}`
                    : undefined
                }
              />
            </div>
          )
        )
      }
    </div>
  </div>
</section>

<style>
  /* Below the breakpoint the scatter would be unreadable, so the items simply
     stack in reading order at the page's own type sizes. */
  .collage {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .collage__item {
    margin: 0;
    line-height: var(--leading-copy);
  }

  .collage__item.is-heading {
    font-size: var(--text-copy);
  }

  .collage__item.is-note {
    font-size: var(--text-label);
  }

  .collage__item.is-marker {
    font-size: var(--text-marker);
  }

  .collage__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .collage__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Figma crops this frame to a window over a taller sprite sheet rather than
     letting it cover the frame. */
  .collage__image img.is-cropped {
    position: absolute;
    width: 100%;
    max-width: none;
    height: var(--crop-h);
    top: var(--crop-top);
    left: var(--crop-left);
    object-fit: fill;
  }

  @media (min-width: 64rem) {
    .collage {
      display: block;
      position: relative;
      container-type: inline-size;
      aspect-ratio: var(--canvas-ratio);
    }

    .collage__item {
      position: absolute;
      left: calc(var(--x) * 1%);
      top: calc(var(--y) * 1%);
      width: calc(var(--w) * 1%);
      /* In the scatter the type scales with the canvas, so the three sizes are
         held as a proportion of it rather than in rem. */
      line-height: 1.667;
    }

    .collage__item.is-heading {
      font-size: var(--collage-heading);
    }

    .collage__item.is-note {
      font-size: var(--collage-note);
    }

    .collage__item.is-marker {
      font-size: var(--collage-marker);
    }

    .collage__image {
      height: calc(var(--h) * 1%);
      aspect-ratio: auto;
    }
  }
</style>
