---
import { nextPage, projects } from '../../data/site';
import { experiments } from '../../data/experiments';
import { concept, hero } from '../../data/home';
import HeroMediaTreatment from '../ui/HeroMediaTreatment.astro';
import ClipStack from '../ui/ClipStack.astro';

const { href, label } = nextPage(Astro.url.pathname.replace(/\/$/, '') || '/');

// The panel shows where the link goes. Home has no single experiment clip, so
// about → home runs the same four-clip cycle as the hero (cross-fades included).
const destination = experiments.find((experiment) => experiment.href === href);
const isAboutHome = Astro.url.pathname.replace(/\/$/, '') === '/about' && href === '/';
// Projects is not one of the experiments, so it has no clip of its own in
// `experiments`; the concept's header footage is what that panel should carry.
const isProjects = href === projects.href;
const video = destination?.video ?? (isProjects ? concept.video : hero.clips[0].video);
const poster = isProjects ? concept.poster : video.replace(/\.mp4$/, '.webp');
const clipLabel = destination
  ? `${destination.title} — a clip from the experiment`
  : isProjects
    ? concept.alt
    : hero.clips[0].alt;
---

{/* Same face as the home hero wordmark, centred over the next clip — the link
    is the panel, not a caption under it. */}
<section class="w-full px-gutter py-section">
  <a
    data-reveal
    href={href}
    class:list={[
      'relative mx-auto flex aspect-[996/560] w-full max-w-[992px] items-center justify-center overflow-hidden bg-surface text-paper',
      isAboutHome && 'next-home',
    ]}
    aria-label={`Go to ${label}${destination ? `: ${destination.title}` : ''}`}
    data-module={isAboutHome ? 'hover-scramble hero-cycle' : 'hover-scramble'}
    style={isAboutHome ? `--hero-interval:${hero.interval}` : undefined}
  >
    <div class="absolute inset-0" aria-hidden="true">
      <HeroMediaTreatment>
        {
          isAboutHome ? (
            <ClipStack clips={hero.clips} />
          ) : (
            video && (
              <video
                class="h-full w-full object-cover"
                data-module="lazy-video"
                data-poster={poster}
                role="img"
                aria-label={clipLabel}
                muted
                loop
                playsinline
                preload="none"
              >
                <source data-src={video} type="video/mp4" />
              </video>
            )
          )
        }
      </HeroMediaTreatment>
    </div>

    <span class="relative z-10 px-gutter text-center font-display text-h2 leading-tight text-balance sm:text-h1 lg:text-hero lg:leading-none">
      → Go to <span data-scramble-text>{label}</span>
    </span>
  </a>
</section>
