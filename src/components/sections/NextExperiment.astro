---
import { nextPage } from '../../data/site';
import { experiments } from '../../data/experiments';
import { hero } from '../../data/home';
import HeroMediaTreatment from '../ui/HeroMediaTreatment.astro';

const { href, label } = nextPage(Astro.url.pathname.replace(/\/$/, '') || '/');

// The panel shows where the link goes. Home has no experiment clip of its own,
// so it shows what the hero opens on.
const destination = experiments.find((experiment) => experiment.href === href);
const isAboutHome = Astro.url.pathname.replace(/\/$/, '') === '/about' && href === '/';
const video = isAboutHome
  ? '/assets/video/about-home-preview-v1.mp4'
  : destination?.video ?? hero.clips[0].video;
const poster = video.replace(/\.mp4$/, '.webp');
const clipLabel = destination
  ? `${destination.title} — a clip from the experiment`
  : hero.clips[0].alt;
---

<section class="flex w-full flex-col items-center gap-4 px-gutter py-section">
  <a
    href={href}
    class="flex w-full max-w-[992px] flex-col items-center gap-4"
    aria-label={`Go to ${label}${destination ? `: ${destination.title}` : ''}`}
    data-module="hover-scramble"
  >
    <div class="aspect-[996/560] w-full overflow-hidden bg-surface">
      <HeroMediaTreatment enabled={isAboutHome}>
      {
        video && (
          <video
            class="h-full w-full object-cover"
            data-module="lazy-video"
            data-poster={poster}
            role="img"
            aria-label={clipLabel}
            muted
            loop
            playsinline
            preload="none"
          >
            <source data-src={video} type="video/mp4" />
          </video>
        )
      }
      </HeroMediaTreatment>
    </div>

    <span class="font-display text-body tracking-tight whitespace-nowrap">
      → Go to <span data-scramble-text>{label}</span>
    </span>
  </a>
</section>
