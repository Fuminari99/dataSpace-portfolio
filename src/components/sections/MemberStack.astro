---
import MemberProfile from './MemberProfile.astro';
import { members } from '../../data/site';

/**
 * The three of us, read side by side rather than one at a time: each panel
 * carries its own copy of the [ KEAGAN ] [ FUMI ] [ MAIYA ] list, with only its
 * own name at full strength, so any of the three names jumps straight to that
 * person's panel from wherever the reader currently is.
 */
---

<section class="w-full px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col items-start gap-16 lg:flex-row lg:justify-center">
    {
      members.map((member) => (
        <div class="flex lg:flex-1 lg:justify-center">
          <MemberProfile member={member} id={member.name.toLowerCase()} />
        </div>
      ))
    }
  </div>
</section>
