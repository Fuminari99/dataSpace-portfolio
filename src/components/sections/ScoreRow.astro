---
import SectionLabel from '../ui/SectionLabel.astro';
import VisualFigure from '../ui/VisualFigure.astro';

export interface Score {
  src: string;
  /** Describes the sheet; the caption alone is just a name. */
  alt: string;
  caption: string;
}

interface Props {
  label: string;
  /** Anchor target, matching the hash the footer link uses. */
  id?: string;
  /** Copy above the row. Several paragraphs stack in one column. */
  lead?: string | string[];
  scores: Score[];
}

const { label, id, lead, scores } = Astro.props;

const leadParagraphs = lead ? [lead].flat() : [];
---

{/*
  A row of sheets read side by side rather than one after another: the three
  layers and the score they add up to are a set, and the comparison between
  them is the point. They keep their own proportions — VisualFigure reads
  those off the file — and fall to two columns, then one, as the row runs out
  of width.
*/}
<section class="w-full px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col gap-6">
    <SectionLabel label={label} id={id} />

    {/* Set like the mixer's intro: the opening paragraph large in the narrow
        column, everything after it small in the wide one. */}
    {
      leadParagraphs.length > 0 && (
        <div
          class="grid grid-cols-1 gap-8 font-body text-copy leading-[1.5] tracking-tight md:grid-cols-[496fr_712fr] md:gap-[72px]"
          data-reveal
        >
          <p class="prose-justified text-body-lg">{leadParagraphs[0]}</p>
          {leadParagraphs.length > 1 && (
            <div class="flex flex-col gap-4">
              {leadParagraphs.slice(1).map((paragraph) => (
                <p class="prose-justified">{paragraph}</p>
              ))}
            </div>
          )}
        </div>
      )
    }

    {/* Marked as a set, so opening one sheet lets the reader step through the
        other three without closing it. */}
    <ul
      class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6"
      data-lightbox-group
    >
      {
        scores.map((score) => (
          <li class="min-w-0" data-reveal>
            <VisualFigure src={score.src} alt={score.alt} name={score.caption} class="w-full" />
          </li>
        ))
      }
    </ul>
  </div>
</section>
