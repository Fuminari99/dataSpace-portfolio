---
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  label: string;
  /** Anchor target, matching the hash the footer link uses. */
  id?: string;
  /** The section's one-sentence statement, set at heading size. */
  lead?: string;
  /** Running copy, laid out in columns beside each other on a wide screen. */
  columns?: string[];
  /** Pulled out of the brief itself, set apart from the running copy. */
  quote?: string;
  /** Where the quote came from, e.g. "the project brief". */
  quoteSource?: string;
}

const { label, id, lead, columns = [], quote, quoteSource } = Astro.props;
---

<section id={id} class="w-full scroll-mt-32 px-gutter py-section">
  <div class="mx-auto flex max-w-page flex-col gap-8">
    <SectionLabel label={label} />

    {lead && <h2 class="max-w-[864px] font-body text-h2 font-bold tracking-tight">{lead}</h2>}

    {
      columns.length > 0 && (
        <div class="flex flex-col gap-8 md:flex-row md:gap-16">
          {columns.map((paragraph) => (
            <p class="prose-justified max-w-[496px] font-body text-body tracking-tight">
              {paragraph}
            </p>
          ))}
        </div>
      )
    }

    {
      quote && (
        <figure class="flex max-w-[864px] flex-col gap-2 border-l border-rule pl-6">
          <blockquote class="font-body text-body-lg tracking-tight">{quote}</blockquote>
          {quoteSource && (
            <figcaption class="font-display text-label tracking-tight opacity-50">
              — {quoteSource}
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>
