---
/**
 * Three accent panels sitting behind the home page content. In Figma they are
 * flat 12%-opacity rectangles carrying a heavy layer blur, which is what turns
 * them into the soft washes the design shows.
 *
 * Positions come from the 1280 x 3959 home frame: `left` and `top` as
 * percentages of it, and the panel's own proportions held by aspect-ratio so a
 * page of a different length keeps the shapes intact.
 */
const FRAME = { width: 1280, height: 3959.33 };

const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`;

const wash = (x: number, y: number, w: number, h: number) => ({
  left: pct(x, FRAME.width),
  top: pct(y, FRAME.height),
  width: pct(w, FRAME.width),
  ratio: `${w} / ${h}`,
});

const washes = [wash(-103, 712, 759, 573), wash(643, 1336, 310, 234), wash(839, 1658, 759, 573)];
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {
    washes.map((item) => (
      <div
        class="absolute bg-accent opacity-12 blur-[7.5rem]"
        style={`left:${item.left};top:${item.top};width:${item.width};aspect-ratio:${item.ratio}`}
      />
    ))
  }
</div>
