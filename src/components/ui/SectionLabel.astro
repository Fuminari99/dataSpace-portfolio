---
interface Props {
  /** Bracketed label text, e.g. "BREATH". Brackets are added here. */
  label: string;
  /** Anchor target for the matching footer / header-overlay link. */
  id?: string;
  /** Inactive members of a label group are dimmed in the design. */
  muted?: boolean;
  href?: string;
  /**
   * `inline` is the small marker used within an experiment page. `heading` is
   * the home page's own section head: the same brackets set in the display face
   * at heading size, and marked up as a heading because that is what it is.
   */
  variant?: 'inline' | 'heading';
  /**
   * Renders the inline label as a heading element rather than a span, for a
   * section whose label is its heading. The label keeps its own classes, which
   * a wrapping <h2> could not do — `heading-scramble` rewrites a heading's text
   * content, and that drops any element nested inside it.
   */
  as?: 'span' | 'h2';
}

const { label, id, muted = false, href, variant = 'inline', as } = Astro.props;
const Tag = href ? 'a' : (as ?? (variant === 'heading' ? 'h2' : 'span'));
---

<Tag
  id={id}
  href={href}
  class:list={[
    'scroll-mt-32 tracking-tight whitespace-nowrap',
    variant === 'heading' ? 'font-display text-h2 leading-[1.1]' : 'font-body text-body',
    muted && 'opacity-50',
  ]}
>
  [ {label} ]
</Tag>
