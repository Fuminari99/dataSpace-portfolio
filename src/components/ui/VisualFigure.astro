---
import sharp from 'sharp';

interface Props {
  /** Still image. Ignored when `video` is set. */
  src?: string;
  /** Looping clip, used in place of the still. */
  video?: string;
  /** First frame, shown until the clip has loaded. */
  poster?: string;
  /** Describes the visual for screen readers; the caption alone is just a name. */
  alt: string;
  /** Left-hand caption, normally the member's name. */
  name: string;
  /** Optional right-hand caption, e.g. the recorded count "56/3min". */
  value?: string;
  /**
   * Fallback proportion, used only when the file's own cannot be read. Every
   * figure otherwise takes the proportions of the footage or still itself.
   */
  ratio?: 'square' | 'video';
  /** Anchor target, set where a footer link points at this figure. */
  id?: string;
  class?: string;
}

const {
  src,
  video,
  poster,
  alt,
  name,
  value,
  ratio = 'square',
  id,
  class: className,
} = Astro.props;

/**
 * The frame takes the proportions of what goes in it rather than cropping to a
 * square. They are read off the file itself at build time — from the still, or
 * from the clip's poster, which is generated at the clip's own size — so the
 * space is reserved before anything has loaded and nothing shifts.
 */
const still = video ? (poster ?? video.replace(/\.mp4$/, '.jpg')) : src;

async function proportions(file?: string) {
  if (!file?.startsWith('/')) return undefined;
  try {
    const { width, height } = await sharp(`public${file}`).metadata();
    return width && height ? `${width} / ${height}` : undefined;
  } catch {
    // A still that is not on disk falls back to the ratio the caller asked for.
    return undefined;
  }
}

const aspect = await proportions(still);
---

<figure id={id} class:list={['flex scroll-mt-32 flex-col gap-2', className]}>
  <div
    class:list={[
      'w-full overflow-hidden bg-placeholder',
      !aspect && (ratio === 'square' ? 'aspect-square' : 'aspect-video'),
    ]}
    style={aspect ? `aspect-ratio:${aspect}` : undefined}
    data-lightbox
  >
    {
      video ? (
        // Loads and plays only while on screen — see the lazy-video module.
        <video
          class="h-full w-full object-cover"
          data-module="lazy-video"
          poster={poster}
          role="img"
          aria-label={alt}
          muted
          loop
          playsinline
          preload="none"
        >
          <source data-src={video} type="video/mp4" />
        </video>
      ) : (
        <img src={src} alt={alt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
      )
    }
  </div>

  <figcaption
    class="flex w-full items-start justify-between font-body text-label leading-[1.8] tracking-[0.01em] opacity-50"
  >
    <span>{name}</span>
    {value && <span class="text-right">{value}</span>}
  </figcaption>
</figure>
