---
import { nav } from '../../data/site';
---

<footer class="w-full bg-footer px-gutter pt-8 pb-section">
  <div
    class="mx-auto flex max-w-page flex-col gap-12 font-display text-label tracking-tight md:flex-row md:gap-[8.0625rem]"
  >
    <p class="md:w-[11.5625rem]">Data Spaces</p>

    <div class="grid flex-1 grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-32">
      {
        nav.map((entry) => (
          <div class="flex flex-col items-end gap-[2.625rem] text-right">
            <a href={entry.href} class="whitespace-nowrap" data-nav-link>
              {entry.label}
            </a>
            <ul class="flex flex-col items-end gap-8">
              {entry.sections.map((section) => (
                <li>
                  <a href={`${entry.href}#${section.hash}`} class="whitespace-nowrap">
                    {section.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
