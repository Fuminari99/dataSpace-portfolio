---
import { nav } from '../../data/site';
import { hero } from '../../data/home';
import HeroMediaTreatment from '../ui/HeroMediaTreatment.astro';
import ClipStack from '../ui/ClipStack.astro';

/**
 * The footer carries the same treatment and clip cycle as the hero: footage
 * under a flat black lift and grain, turning over on the same interval, with
 * the columns set over it in white.
 */
---

<footer
  class="relative mt-16 w-full overflow-hidden bg-ink px-gutter pt-8 pb-section text-paper"
  data-module="hero-cycle"
  style={`--hero-interval:${hero.interval}`}
>
  <div class="absolute inset-0" aria-hidden="true">
    <HeroMediaTreatment>
      <ClipStack clips={hero.clips} />
    </HeroMediaTreatment>
  </div>

  <div
    class="relative mx-auto flex max-w-page flex-col gap-12 font-display text-label tracking-tight md:flex-row md:gap-[128px]"
  >
    <p class="md:w-[184px]">Data Spaces</p>

    <div class="grid flex-1 grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-12 xl:gap-x-32">
      {
        nav.map((entry) => (
          <div class="flex flex-col items-end gap-[40px] text-right">
            <a href={entry.href} class="whitespace-nowrap" data-nav-link>
              {entry.label}
            </a>
            <ul class="flex flex-col items-end gap-8">
              {entry.sections.map((section) => (
                <li>
                  <a href={`${entry.href}#${section.hash}`}>
                    {section.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>
