---
import { headerNav } from '../../data/site';

interface Props {
  /**
   * Lifts the bar out of the flow so the page below it can start at the top of
   * the viewport. Used by the home page, whose hero owns the first screen: the
   * bar rides over the footage in white, then takes the paper background once
   * the hero has been scrolled past.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Each page ships its own header inside the Barba container, so the current
// page is resolved here at build time and needs no re-syncing after a swap.
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const items = headerNav;
---

<header
  class:list={[
    'z-20 w-full pt-4',
    overlay ? 'site-header--overlay text-paper' : 'sticky top-0 bg-paper',
  ]}
  data-module={overlay ? 'nav-scramble header-reveal' : 'nav-scramble'}
>
  <nav
    class="mx-auto flex max-w-page items-center justify-between py-4 font-display text-label tracking-tight"
    aria-label="Main"
  >
    {
      items.map((item) => {
        // The page you are on wears its full title permanently — that is the
        // marker for where you are — so there is nothing left for it to swap to
        // and it does not respond to hover.
        const isCurrent = item.href === current;

        return (
          <div
            class="nav-item"
            data-nav-item
            data-nav-static={isCurrent ? '' : undefined}
          >
            <a
              href={item.href}
              class:list={['nav-link', { 'is-current': isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
              aria-label={
                item.label === item.hoverLabel ? item.label : `${item.label}: ${item.hoverLabel}`
              }
              data-nav-link
              data-label={item.label}
              data-hover-label={item.hoverLabel}
            >
              {/* Reserves the short label's width so swapping in the long one on
                  hover cannot shift the rest of the bar. The current item keeps
                  the same reservation, so being long does not move its
                  neighbours either. */}
              <span class="nav-link__sizer" aria-hidden="true">
                {item.label}
              </span>
              <span class="nav-link__text" aria-hidden="true" data-nav-text>
                {isCurrent ? item.hoverLabel : item.label}
              </span>
            </a>
          </div>
        );
      })
    }
  </nav>
</header>

<style>
  /* Out of the flow entirely, so the hero starts at the top of the viewport
     rather than under the bar. It sits over the footage in white for as long as
     the hero is on screen. */
  .site-header--overlay {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
  }

  /* Past the hero there is no footage left to read against, so the bar takes
     the page's own colours. */
  .site-header--overlay.is-on-paper {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  /* Three items spread across the bar: Home on the left edge, About on the
     right, Projects between them. The gap is only a floor — `justify-between`
     supplies the rest. */
  nav {
    gap: 32px;
    padding-inline: var(--spacing-gutter);
  }

  /* At the design's own width the bar already stops at 1280px, so the gutter
     comes off and the outer two sit on the container's own edges. */
  @media (min-width: 80rem) {
    nav {
      padding-inline: 0;
    }
  }

  .nav-item {
    position: relative;
    flex: none;
  }

  .nav-link {
    position: relative;
    display: inline-block;
  }

  .nav-link__sizer {
    visibility: hidden;
    white-space: nowrap;
  }

  /* The long label grows leftwards into the gap rather than pushing neighbours. */
  .nav-link__text {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    white-space: nowrap;
  }

  /* "Home" anchors from the left instead, matching the design. */
  .nav-item:first-child .nav-link__text {
    inset-inline-end: auto;
    inset-inline-start: 0;
  }
</style>
