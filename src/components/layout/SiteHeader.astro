---
import { headerNav, home, nav, projects } from '../../data/site';

interface Props {
  /**
   * Lifts the bar out of the flow so the page below it can start at the top of
   * the viewport. Used by the home page, whose hero owns the first screen: the
   * bar rides over the footage in white, then takes the paper background once
   * the hero has been scrolled past.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Each page ships its own header inside the Barba container, so the current
// page is resolved here at build time and needs no re-syncing after a swap.
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const items = headerNav;

// The four experiments hang off Projects in the bar: they are reached through
// it, and the footer lists them as columns of their own.
const experiments = nav.filter((entry) => entry.href.startsWith('/ex'));

/**
 * The narrow-screen panel. Home is not in it — it stays on the bar as the mark,
 * where a reader expects it. The four experiments are indented under Project
 * Concept the way the site nests them, and each carries its number as well as
 * its title, since there is no bar above them to say which is which.
 */
const about = headerNav[headerNav.length - 1];
const menuItems = [
  { entry: projects, label: projects.hoverLabel, nested: false },
  ...experiments.map((entry) => ({
    entry,
    label: `${entry.label.toUpperCase()} ${entry.hoverLabel}`,
    nested: true,
  })),
  { entry: about, label: about.hoverLabel, nested: false },
];
---

<header
  class:list={[
    'z-20 w-full pt-4',
    overlay ? 'site-header--overlay text-paper' : 'sticky top-0 bg-paper',
  ]}
  data-module={overlay ? 'nav-scramble header-reveal menu' : 'nav-scramble menu'}
>
  {/* While the Projects panel is open the bar's own surface runs down behind
      it, so the four links are read against the site rather than against
      whatever the page happens to have under them. */}
  <span class="nav-band" aria-hidden="true"></span>

  <nav
    class="mx-auto flex max-w-page items-center justify-between py-4 font-display text-label tracking-tight"
    aria-label="Main"
  >
    {
      items.map((item) => {
        // The page you are on wears its full title permanently — that is the
        // marker for where you are — so there is nothing left for it to swap to
        // and it does not respond to hover.
        const isCurrent = item.href === current;

        return (
          <div
            class:list={['nav-item', { 'nav-item--sub': item.href === projects.href }]}
            data-nav-item
            data-nav-static={isCurrent ? '' : undefined}
          >
            <a
              href={item.href}
              class:list={['nav-link', { 'is-current': isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
              aria-label={
                item.label === item.hoverLabel ? item.label : `${item.label}: ${item.hoverLabel}`
              }
              data-nav-link
              data-label={item.label}
              data-hover-label={item.hoverLabel}
            >
              {/* Reserves the short label's width so swapping in the long one on
                  hover cannot shift the rest of the bar. The current item keeps
                  the same reservation, so being long does not move its
                  neighbours either. */}
              <span class="nav-link__sizer" aria-hidden="true">
                {item.label}
              </span>
              <span class="nav-link__text" aria-hidden="true" data-nav-text>
                {isCurrent ? item.hoverLabel : item.label}
              </span>
            </a>

            {item.href === projects.href && (
              <ul class="nav-sub" aria-label="Experiments">
                {experiments.map((experiment) => (
                  <li class="nav-item" data-nav-item>
                    <a
                      href={experiment.href}
                      class="nav-link"
                      aria-label={`${experiment.label}: ${experiment.hoverLabel}`}
                      data-nav-link
                      data-label={experiment.label}
                      data-hover-label={experiment.hoverLabel}
                    >
                      {/* Same reservation as the bar above: the full title is
                          longer than the short label, and grows leftwards into
                          the panel rather than moving anything. */}
                      <span class="nav-link__sizer" aria-hidden="true">
                        {experiment.label}
                      </span>
                      <span class="nav-link__text" aria-hidden="true" data-nav-text>
                        {experiment.label}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })
    }
  </nav>

  {
    /* Below the breakpoint the bar is more than a phone has room for — three
       items with four more hanging off one of them — so it becomes a mark and
       a button. Over the hero it inherits the bar's own white, and takes the
       page's ink once the hero has been scrolled past. */
    (
      <>
        <div class="nav-mobile">
          <a
            href={home.href}
            class="nav-mobile__brand"
            aria-label={`${home.label}: ${home.hoverLabel}`}
            aria-current={home.href === current ? 'page' : undefined}
          >
            {home.hoverLabel}
          </a>

          <button
            type="button"
            class="nav-toggle"
            data-menu-toggle
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="site-menu"
          >
            {/* Two rules that fold into a cross. Both turn about the middle
                of the same 24-unit box, so the bars and the cross share a
                centre and the icon does not shift as it changes. */}
            <svg class="nav-toggle__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <line data-menu-bar x1="2" y1="9" x2="22" y2="9" />
              <line data-menu-bar x1="2" y1="15" x2="22" y2="15" />
            </svg>
          </button>
        </div>

        <div class="nav-menu" id="site-menu" data-menu-panel aria-hidden="true">
          <ul class="nav-menu__list">
            {menuItems.map(({ entry, label, nested }) => {
              const isCurrent = entry.href === current;
              return (
                <li class:list={{ 'is-nested': nested }}>
                  {/* The dash sits in the indent as the mark of nesting; it is
                      decoration, so it is not read out with the link. */}
                  {nested && (
                    <span class="nav-menu__dash" aria-hidden="true">
                      -
                    </span>
                  )}
                  <a
                    href={entry.href}
                    class:list={['nav-menu__link', { 'is-current': isCurrent }]}
                    aria-current={isCurrent ? 'page' : undefined}
                    data-menu-link
                  >
                    {label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </>
    )
  }
</header>

<style>
  /* Out of the flow entirely, so the hero starts at the top of the viewport
     rather than under the bar. It sits over the footage in white for as long as
     the hero is on screen. */
  /* No `position` here: the bar is already sticky or fixed from the class list,
     and setting it in this block would beat that and drop the bar out of the
     top of the page. Both of those are containing blocks for the band below. */
  header {
    /* The band's drop below the bar: the panel's own height, kept here so the
       two cannot drift apart. */
    --nav-sub-height: 152px;
    --nav-band-colour: var(--color-paper);
    --nav-band-rule: var(--color-rule);
  }

  .site-header--overlay {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    /* Over the footage the bar has no surface of its own, so the band supplies
       one: the same flat black lift the hero already sits under. */
    --nav-band-colour: rgba(0, 0, 0, 0.72);
    --nav-band-rule: var(--color-hero-rule);
  }

  .site-header--overlay.is-on-paper {
    --nav-band-colour: var(--color-paper);
    --nav-band-rule: var(--color-rule);
  }

  .nav-band {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: calc(100% + var(--nav-sub-height));
    border-block-end: 1px solid var(--nav-band-rule);
    background-color: var(--nav-band-colour);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  header:has(.nav-item--sub:hover) .nav-band,
  header:has(.nav-item--sub:focus-within) .nav-band {
    opacity: 1;
    visibility: visible;
  }

  /* Above the band, which is otherwise painted over the links it is there to
     carry. */
  nav {
    position: relative;
    z-index: 1;
  }

  /* Past the hero there is no footage left to read against, so the bar takes
     the page's own colours. */
  .site-header--overlay.is-on-paper {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  /* Three items spread across the bar: Home on the left edge, About on the
     right, Projects between them. The gap is only a floor — `justify-between`
     supplies the rest. */
  nav {
    gap: 32px;
    padding-inline: var(--spacing-gutter);
  }

  /* At the design's own width the bar already stops at 1280px, so the gutter
     comes off and the outer two sit on the container's own edges. */
  @media (min-width: 80rem) {
    nav {
      padding-inline: 0;
    }
  }

  .nav-item {
    position: relative;
    flex: none;
  }

  .nav-link {
    position: relative;
    display: inline-block;
  }

  .nav-link__sizer {
    visibility: hidden;
    white-space: nowrap;
  }

  /* The long label grows leftwards into the gap rather than pushing neighbours. */
  .nav-link__text {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    white-space: nowrap;
  }

  /* The four experiments sit under Projects, out of the way until the item is
     pointed at or tabbed into. Hidden with `visibility` rather than `display`
     so the links stay in the tab order's reach only while the panel is open,
     and the reservation above keeps the bar from moving when it opens. */
  /* Ranged right, on the same edge as the label above them: the panel reads as
     one column with "Project Concept" at its head. */
  .nav-sub {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    /* Bridges the gap between the label and the list, so the pointer can cross
       into the panel without passing over dead space. */
    padding-block-start: 16px;
    /* Matches --nav-sub-height above, less the bar's own bottom padding. */
    min-height: 136px;
    opacity: 0;
    visibility: hidden;
  }

  .nav-item:hover .nav-sub,
  .nav-item:focus-within .nav-sub {
    opacity: 1;
    visibility: visible;
  }

  /* Touch devices cannot hover-open the panel, and tapping Projects navigates
     away: keep the four experiment links reachable under the bar. */
  @media (hover: none) {
    .nav-item--sub {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    .nav-sub {
      position: static;
      align-items: flex-end;
      gap: 4px 12px;
      padding-block-start: 8px;
      min-height: 0;
      opacity: 1;
      visibility: visible;
    }
  }

  /* "Home" anchors from the left instead, matching the design. Scoped to the
     bar itself: the experiments in the panel below all anchor right. */
  nav > .nav-item:first-child .nav-link__text {
    inset-inline-end: auto;
    inset-inline-start: 0;
  }

  /* ---- narrow screens: the bar hands over to a button and a panel ---- */

  .nav-mobile,
  .nav-menu {
    display: none;
  }

  @media (max-width: 47.99rem) {
    /* The bar's own items go; the mark and the button take the same line. */
    header:has(.nav-mobile) nav {
      display: none;
    }

    .nav-mobile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-inline: var(--spacing-gutter);
      padding-block: 4px;
      /* Over the panel, which covers everything else — the mark and the close
         control stay in reach while it is open. */
      position: relative;
      z-index: 2;
    }

    .nav-mobile__brand {
      font-family: var(--font-display);
      font-size: var(--text-label);
      letter-spacing: var(--tracking-tight);
      white-space: nowrap;
      /* Same 44px reach as the button beside it. */
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      /* A 44px target, the same floor the mixer's controls use, around a
         24px icon. */
      width: 44px;
      height: 44px;
      padding: 0;
      cursor: pointer;
    }

    .nav-toggle__icon {
      display: block;
      overflow: visible;
    }

    .nav-toggle__icon line {
      stroke: currentcolor;
      stroke-width: 1;
    }

    /* The panel is paper. On the home page the bar is white over the hero, so
       without this the mark and the close control are white on white once it
       opens. */
    header:has([data-menu-panel][data-open]) .nav-mobile {
      color: var(--color-ink);
    }

    .nav-toggle:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 4px;
    }

    .nav-menu {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 1;
      background-color: var(--color-paper);
      color: var(--color-ink);
      /* The script owns these; the panel is off screen until it opens, and
         stays off screen entirely if the script never runs. */
      visibility: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .nav-menu__list {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 96px var(--spacing-gutter) var(--spacing-section);
    }

    /* Set in from the two that are not experiments, so the four read as
       sitting under Project Concept rather than beside it, and a step down in
       size to match. */
    .nav-menu__list li.is-nested {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding-inline-start: 12px;
    }

    .nav-menu__dash {
      font-family: var(--font-display);
      font-size: var(--text-body);
      opacity: 0.5;
    }

    .nav-menu__list li.is-nested .nav-menu__link {
      font-size: var(--text-body);
    }

    .nav-menu__link {
      display: inline-block;
      font-family: var(--font-display);
      font-size: var(--text-body-lg);
      letter-spacing: var(--tracking-tight);
      /* Comfortably past the 44px target on its own line. */
      padding-block: 8px;
    }

    .nav-menu__link.is-current {
      opacity: 0.5;
    }
  }
</style>
